{
  "version": 1,
  "services": [
    {
      "name": "web",
      "dockerfile": "Dockerfile",
      "context": ".",
      "route": "public",
      "port": 3000,
      "healthPath": "/healthz",
      "storage": { "sizeGb": 1, "mountPath": "/data", "fsGroup": 1000 },
      "resources": { "cpu": 2, "memoryMb": 2048 }
    }
  ],
  "models": [
    { "env": "TEXT_MODEL", "type": "chat", "default": "gpt-6-luna" }
  ]
}
